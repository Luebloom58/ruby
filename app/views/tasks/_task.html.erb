<% modal_id = "delete_modal_#{task.id}" %>

<div class="flex items-center justify-between p-5 bg-white shadow-sm rounded-lg border border-gray-200 hover:shadow-md transition">
  
  <div class="flex items-center gap-4">
    <%# The Toggle Checkbox Button %>
    <%= button_to toggle_task_path(task), method: :patch, class: "rounded-full w-8 h-8 flex items-center justify-center border-2 transition cursor-pointer #{task.completed ? 'bg-green-500 border-green-500' : 'bg-transparent border-gray-300 hover:border-green-400'}" do %>
      <% if task.completed %>
        <span class="text-white font-bold">✓</span>
      <% end %>
    <% end %>

    <%# Task Text & Badges %>
    <div>
      <div class="flex items-center gap-3 mb-1">
        <h3 class="text-lg font-bold <%= task.completed ? 'line-through text-gray-400' : 'text-gray-900' %>">
          <%= task.title %>
        </h3>
        
        <%# The Status Badge %>
        <% if task.completed %>
          <span class="bg-green-100 text-green-700 py-0.5 px-2.5 rounded-full text-xs font-semibold tracking-wide">Done</span>
        <% else %>
          <span class="bg-yellow-100 text-yellow-700 py-0.5 px-2.5 rounded-full text-xs font-semibold tracking-wide">Pending</span>
        <% end %>
      </div>

      <p class="text-xs text-gray-500">
        Created: <%= task.created_at.strftime("%d %b %Y") %> &nbsp;|&nbsp; 
        Updated: <%= time_ago_in_words(task.updated_at) %> ago
      </p>
    </div>
  </div>

  <%# Actions %>
  <div class="flex space-x-4">
    <button onclick="document.getElementById('<%= modal_id %>').showModal()" class="text-red-500 hover:text-red-700 font-medium text-sm bg-transparent border-none cursor-pointer">
      Delete
    </button>
  </div>

</div>

<%# MOVE THIS HERE: Completely outside the flex layout! %>
<dialog id="<%= modal_id %>" class="backdrop:bg-black/50 p-0 rounded-lg shadow-2xl m-auto bg-transparent open:animate-fade-in">
  <div class="bg-white w-80 p-6 rounded-lg text-left border border-gray-200">
    <h3 class="text-lg font-bold text-gray-900 mb-2">Delete Task?</h3>
    <p class="text-sm text-gray-500 mb-6">Are you sure you want to delete "<%= task.title %>"? This cannot be undone.</p>
    
    <div class="flex justify-end gap-3">
      <form method="dialog">
        <button class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg text-sm font-medium transition cursor-pointer">Cancel</button>
      </form>
      <%= button_to 'Delete', task, method: :delete, class: "px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition cursor-pointer" %>
    </div>
  </div>
</dialog>