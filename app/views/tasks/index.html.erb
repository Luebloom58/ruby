<div class="max-w-4xl mx-auto mt-10">
  
  <% if notice.present? %>
    <p class="bg-green-50 text-green-700 p-4 rounded mb-6 border border-green-200"><%= notice %></p>
  <% end %>

  <%# Header Section %>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-4xl font-bold text-gray-800">To Do List</h1>
  </div>

  <%# The Count Banner %>
  <%= render 'banner', tasks: @tasks %>

  <div class="mb-8 mt-6">
    <%= render 'inline_form', task: Task.new %>
  </div>

  <%# The Tasks List %>
  <div id="tasks" class="space-y-4 max-h-[60vh] overflow-y-auto p-1">
    <% @tasks.each do |task| %>
      <%= turbo_frame_tag task do %>
        <%= render 'task', task: task %>
      <% end %>
    <% end %>
  </div>
<div id="toasts" class="fixed bottom-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>
</div>