<div id="todo-banner" class="flex gap-4 mb-8">
<div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 flex-1 text-center">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Total</h2>
    <p class="text-3xl font-bold text-blue-600"><%= tasks.count %></p>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 flex-1 text-center">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Pending</h2>
    <p class="text-3xl font-bold text-yellow-600"><%= tasks.reject(&:completed).count %></p>
  </div>
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 flex-1 text-center">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Completed</h2>
    <p class="text-3xl font-bold text-green-600"><%= tasks.select(&:completed).count %></p>
  </div>
</div>